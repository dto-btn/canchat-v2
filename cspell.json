{
	"import": ["@cspell/dict-fr-fr/cspell-ext.json"],
	"words": ["CANChat", "Cohere", "Excel", "extrants"],
	"ignoreRegExpList": ["Email", "Urls", "/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/g"],
	"overrides": [
		{
			"filename": "src/lib/i18n/locales/en-GB/**",
			"language": "en-GB"
		},
		{
			"filename": "src/lib/i18n/locales/fr-CA/**",
			"language": "fr"
		}
	]
}
